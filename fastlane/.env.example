# Copy to fastlane/.env (gitignored) and fill in ONE of the two credential
# sets. Notarization is required for the build and release lanes.

# --- Preferred: API key (no password, no 2FA prompts) -----------------------
# This is an "App Store Connect API key", but it's purely an auth token for
# Apple's notary service — nothing is published to the App Store.
# Create one at https://appstoreconnect.apple.com → Users and Access →
# Integrations → Team Keys → Generate API Key (role: Developer is enough).
# Download the .p8 once and keep it somewhere safe (e.g. ~/.appstoreconnect/).
ASC_KEY_ID=7D5L5R9JY6
ASC_ISSUER_ID=22a61a95-87fc-4d5c-801b-3254d700ee63
ASC_KEY_PATH=/Users/matcom/.openclaw/Apple_Key_MCSoftware.p8

# --- Fallback: Apple ID + app-specific password ------------------------------
# Create an app-specific password at https://account.apple.com/account/manage
# NOTARIZE_APPLE_ID=matteo@mcsoftware.dev
# FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD=abcd-efgh-ijkl-mnop

# Sparkle update signing uses the EdDSA key in the login keychain
# (account "Skillet", created with `generate_keys --account Skillet`).
# GitHub publishing uses the `gh` CLI and its existing authentication.
